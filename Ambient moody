local FullBright = true -- Enabled by default
local Lighting = game:GetService("Lighting")

-- Ensure StimEffect exists
local function ensureStimEffect()
    local stimEffect = Lighting:FindFirstChild("StimEffect")
    if not stimEffect then
        stimEffect = Instance.new("ColorCorrectionEffect")
        stimEffect.Name = "StimEffect"
        stimEffect.Parent = Lighting
    end
    return stimEffect
end

game:GetService("RunService").Heartbeat:Connect(function()
    local success, err = pcall(function()
        local stimEffect = ensureStimEffect()
        if FullBright then
            sethiddenproperty(stimEffect, "Brightness", 0.1)
            sethiddenproperty(stimEffect, "Contrast", 0)
            sethiddenproperty(stimEffect, "Enabled", true)
            sethiddenproperty(stimEffect, "Saturation", 2)
        else
            sethiddenproperty(stimEffect, "Brightness", 0.2)
            sethiddenproperty(stimEffect, "Contrast", 0.8)
            sethiddenproperty(stimEffect, "Enabled", false)
            sethiddenproperty(stimEffect, "Saturation", 1)
        end
    end)
    if not success then
        warn("FullBright Error: " .. tostring(err))
    end
end)
